[user]
	email = ubinkitte.shifting140@slmail.me
	name = UBinKitte
[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[push]
	default = current

[init]
	defaultBranch = main
[pull]
	ff = only

[core]
quotePath = false
pager = delta

[interactive]
diffFilter = delta --color-only

[delta]
navigate = true
line-numbers = true
