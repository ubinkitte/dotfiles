{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp/oauth",
        "enabled": true
      }
    }
  }
}
