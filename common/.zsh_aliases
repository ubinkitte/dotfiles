# shell
alias ll='ls -l'
alias la='ls -la'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias ln='ln -i'
alias cx='chmod +x'
alias mkdir='mkdir -p'
alias less='less -R'
alias grep='grep --color=auto'

# tools
_has() { command -v "$1" >/dev/null 2>&1; }

alias r='reload'

alias g='git'
alias ffmpeg='ffmpeg -hide_banner'
alias ffprobe='ffprobe -hide_banner'
alias py='python3'

# # neovim
if _has nvim; then
  alias vi='nvim'
elif _has vim; then
  alias vi='vim'
fi

# # bat
if _has batcat; then
  alias bat='batcat'
  alias cat='batcat --paging=never --style=plain --color=auto'
elif _has bat; then
  alias cat='bat --paging=never --style=plain --color=auto'
fi

# functions
if [[ "$OSTYPE" == linux* ]]; then
  open() {
    command xdg-open "${1:-.}"
  }
fi

copy() {
    if _has pbcopy; then
        local cmd=(pbcopy)
    elif _has wl-copy; then
        local cmd=(wl-copy)
    elif _has xclip; then
        local cmd=(xclip -selection clipboard)
    elif _has xsel; then
        local cmd=(xsel --clipboard --input)
    else
        echo "No suitable clipboard command found." >&2
        return 1
    fi

    if (( $# )); then
        printf '%s' "$*" | "${cmd[@]}"
    else
        "${cmd[@]}"
    fi
}

zip() {
  command zip "$@" \
    -x '*/.DS_Store' \
       '*/.DS_Store/*'
}

reload() {
    printf "\e[3J" && clear && hash -r
    zsh -n ~/.zshrc || return 1
    exec zsh
}

if [[ -o interactive ]]; then
  cd() {
    if (( $# == 1 )) && [[ -f "$1" ]]; then
      builtin cd -- "${1:h}"
    else
      builtin cd -- "$@"
    fi
  }
fi

## fzf-based functions
fkill() {
    local signal="${1:--9}"
    local pids
    pids=$(ps -ef \
      | sed 1d \
      | fzf --multi --header='[TAB] Multi-Select [Enter] kill' \
            --preview='echo {}' --preview-window='down:3:wrap' \
      | awk '{print $2}')
    [[ -n "$pids" ]] && echo "$pids" | xargs kill "$signal" \
      && echo "killed: $pids"
}
